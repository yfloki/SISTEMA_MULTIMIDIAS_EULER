{
  "name": "aurora-plus",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,media,web -c magenta,yellow,cyan \"npm run dev -w apps/api\" \"npm run dev -w apps/media\" \"npm run dev -w apps/web\"",
    "setup": "node scripts/download.mjs && node scripts/process.mjs",
    "test": "npm run test -ws --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "ffmpeg-static@5.3.0": true,
    "sharp@0.34.5": true
  }
}
