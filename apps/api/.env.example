# Todas opcionais.

# Diretório do conteúdo (fonte, HLS, imagens, banco). Default: ../../content
# CONTENT_DIR=../../content

# Retransmissão para YouTube (simulcast). Pode também ser configurada pela UI
# do Estúdio (/admin). NUNCA commite este valor.
# YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2/SUA-CHAVE-AQUI
